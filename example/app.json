{
  "expo": {
    "name": "Reactor RN",
    "slug": "react-native-reactor-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "inc.reactor.rn.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "inc.reactor.rn.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-reactor",
        {
          "cameraPermission": "Streams your camera to the world model you are steering.",
          "microphonePermission": "Streams your voice to the world model you are steering."
        }
      ],
      "expo-video"
    ]
  }
}